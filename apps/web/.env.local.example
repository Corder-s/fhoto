# ==============================================================================
# INSTANTSHOOT LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.local.example .env.local
# DO NOT commit real secrets or production service-role keys to version control.
# ==============================================================================

# SUPABASE CLIENT CREDENTIALS (Publicly accessible in browser)
# Replace with your Supabase project URL and anon public key from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# SUPABASE SERVER-SIDE SERVICE ROLE KEY (SERVER ONLY - NEVER EXPOSE TO CLIENT)
# Used only in privileged Next.js Route Handlers (/api/bookings, /api/payments)
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# PAYMENT PROVIDER CONFIGURATION (Razorpay / Cashfree / Stripe)
# Leave blank for local development to activate auditable Sandbox Test Mode
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# APPLICATION ROOT URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI ASSISTANT (GOOGLE GEMINI)
# Configured on SnapShoot backend server (apps/api or root .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

