# ==============================================================================
# INSTANTSHOOT LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.local.example .env.local
# DO NOT commit real secrets or production service-role keys to version control.
# ==============================================================================

# SUPABASE CLIENT CREDENTIALS (Publicly accessible in browser)
# Replace with your Supabase project URL and anon public key from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# SUPABASE SERVER-SIDE SERVICE ROLE KEY (SERVER ONLY - NEVER EXPOSE TO CLIENT, never prefix with NEXT_PUBLIC_)
# Used only by server route handlers after authorize() has verified the caller.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# PAYMENT PROVIDER CONFIGURATION (Razorpay / Cashfree / Stripe)
# Leave blank for local development to activate auditable Sandbox Test Mode
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# APPLICATION ROOT URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MAP SEARCH (Mapbox). NEXT_PUBLIC_MAPBOX_TOKEN must be a public (pk.*) token; it is shipped to browsers.
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_ACCESS_TOKEN=

# AI ASSISTANT (GOOGLE GEMINI) - SERVER ONLY. Read by apps/web/src/app/api/v1/ai/chat/route.ts
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

