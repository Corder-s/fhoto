# ==============================================================================
# INSTANTSHOOT LOCAL ENVIRONMENT CONFIGURATION  (apps/web)
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.local.example .env.local
# DO NOT commit real secrets or production service-role keys to version control.
#
# Every value that reads "REQUIRED" here also has to exist in the Vercel project
# (Settings > Environment Variables) for a hosted deployment. That table, with
# the scopes to use, is in the root README under "Deploying to Vercel".
# Variables prefixed NEXT_PUBLIC_ are inlined at build time: redeploy after
# changing them, restarting is not enough.
# Run `npm run env:check` to validate this file.
# ==============================================================================

# SUPABASE CLIENT CREDENTIALS (Publicly accessible in browser) - REQUIRED
# Replace with your Supabase project URL and anon public key from Project Settings > API
# Vercel scope: all environments
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# SUPABASE SERVER-SIDE SERVICE ROLE KEY (SERVER ONLY - NEVER EXPOSE TO CLIENT, never prefix with NEXT_PUBLIC_)
# Used only by server route handlers after authorize() has verified the caller. - REQUIRED
# Vercel scope: Production and Preview
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# NESTJS SERVICE (apps/api). Origin only, without /api/v1. - OPTIONAL
# Enables the /api/v1/* proxy in next.config.mjs. Without it those paths 404,
# which is correct for a deployment that does not run apps/api.
# Vercel scope: Production and Preview
# NEST_API_BASE_URL="https://api.example.com"

# PAYMENT PROVIDER CONFIGURATION (Razorpay Standard Checkout) - OPTIONAL
# Leave blank for local development to activate auditable Development Sandbox Checkout.
# To connect live Razorpay Checkout in test or production mode:
# - NEXT_PUBLIC_RAZORPAY_KEY_ID: Public merchant Key ID used by Razorpay Checkout JS modal.
# - RAZORPAY_KEY_ID: Server-side merchant Key ID (or falls back to NEXT_PUBLIC_RAZORPAY_KEY_ID).
# - RAZORPAY_KEY_SECRET: Server-side secret key (NEVER expose to client; used for orders & HMAC verification).
# - RAZORPAY_WEBHOOK_SECRET: Secret configured in Razorpay Webhook dashboard for signature validation.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MAP SEARCH (Mapbox). NEXT_PUBLIC_MAPBOX_TOKEN must be a public (pk.*) token; it is shipped to browsers. - OPTIONAL
# Mapbox search is disabled when it is blank.
# Vercel scope: all environments
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_ACCESS_TOKEN=

# AI ASSISTANT (GOOGLE GEMINI) - SERVER ONLY - OPTIONAL
# Read by apps/web/src/app/api/v1/ai/chat/route.ts.
# Without the key the route answers with error code GEMINI_API_KEY_MISSING.
# Vercel scope: Production and Preview
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# TRANSACTIONAL EMAIL & EMAIL OTP (Gmail SMTP or Custom SMTP) - REQUIRED FOR LIVE EMAIL DELIVERY
# To send verification OTPs to inboxes:
# Option A (Gmail): Set GMAIL_USER to your Gmail and GMAIL_APP_PASSWORD to a 16-character App Password.
# Option B (Generic SMTP): Set SMTP_HOST, SMTP_PORT (587 or 465), SMTP_USER, and SMTP_PASS.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_ADDRESS="SnapShoot Visual Marketplace" <noreply@snapshoot.in>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# NOT READ BY ANY CODE PATH YET (placeholders kept for planned features)
# PAYMENT_PROVIDER_WEBHOOK_SECRET, NEXT_PUBLIC_APP_URL
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
