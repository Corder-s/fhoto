# ==========================================
# SNAPSHOOT ENVIRONMENT CONFIGURATION
# ==========================================

# SERVER & NETWORK
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1

# DATABASE & POSTGIS
# PostgreSQL connection string with PostGIS enabled
DATABASE_URL="postgresql://snapshoot_user:snapshoot_secret@localhost:5432/snapshoot_db?schema=public"

# REDIS CACHE & QUEUE
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT & SESSION SECURITY
JWT_ACCESS_SECRET="CHANGE_THIS_TO_A_32_CHAR_RANDOM_SECRET_KEY"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_ANOTHER_RANDOM_SECRET_KEY"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# PHONE OTP / SMS SERVICE (MOCK_MODE=true for local dev)
SMS_PROVIDER=mock # mock | twilio | msg91
SMS_MOCK_STATIC_OTP="123456"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# PAYMENT GATEWAY (RAZORPAY / CASHFREE)
PAYMENT_GATEWAY_PROVIDER=razorpay # razorpay | cashfree
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="webhook_secret_placeholder"

# OBJECT STORAGE (CLOUDFLARE R2 / AWS S3)
STORAGE_PROVIDER=r2 # r2 | s3
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME="snapshoot-media"
S3_PUBLIC_DOMAIN="https://media.snapshoot.local"

# MAPS & GEOCODING
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
